# Copy to .env and adjust as needed. All values are optional.

# Target environment defined in config/environments.ts (default: prod)
ENV=prod

# Override the environment's base URL for an ad-hoc run
# BASE_URL=https://www.rbauction.com

# Run browsers headless. Default false: Akamai blocks headless traffic on rbauction.com
# HEADLESS=false

# Also run UI tests on Firefox, WebKit and mobile Chrome
# ALL_BROWSERS=false

# Set automatically by CI providers; enables retries, forbidOnly and the GitHub reporter
# CI=true
